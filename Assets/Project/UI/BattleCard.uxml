<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/BattleCard.uss?fileID=7433441132597879392&amp;guid=d71f3b08657e4af9ab8610c92c24b7e4&amp;type=3#BattleCard"/>
    <ui:Button name="card-button" class="card-face" style="height: 126px; width: 76px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; overflow: visible; background-color: rgba(22, 26, 35, 0);">
        <ui:Image name="artwork" class="card-artwork" style="background-image: none; right: 3px; bottom: 9px; top: 4px;"/>
        <ui:VisualElement name="card-holo-glow" picking-mode="Ignore" class="card-holo-glow"/>
        <ui:Image name="card-rank-frame" picking-mode="Ignore" class="card-rank-frame" style="background-image: none; bottom: -2px; left: -3px; right: -3px; top: -3px;"/>
        <ui:Label name="card-skill-slot" picking-mode="Ignore" class="card-skill-slot"/>
        <ui:Image name="card-skill-type" picking-mode="Ignore" class="card-skill-type" style="background-image: none; height: 20px; width: 20px; top: 1px; right: 1px;"/>
        <ui:VisualElement name="card-disabled-overlay" picking-mode="Ignore" class="card-disabled-overlay" />
    </ui:Button>
</ui:UXML>
