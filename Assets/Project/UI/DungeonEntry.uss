@import url("project://database/Assets/Project/Resources/UI/ScreenShell.uss?fileID=7433441132597879392&guid=6d1566d098bce684493804ab080e2ee6&type=3#ScreenShell");
.arena-background { background-image: url("../Art/UI/DungeonEntry/ArenaBackground.png"); }
.headline { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 18px; }
.headline Label { font-size: 92px; margin-right: 24px; }
.headline-red { color: rgb(244, 34, 44); }
.dungeon-browser { width: 58%; min-width: 0; min-height: 0; padding-right: 34px; }
.category-controls { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 16px; padding: 12px; background-color: rgba(6, 15, 26, .96); }
.category-controls DropdownField { flex-grow: 1; flex-basis: 0; min-width: 120px; margin-right: 8px; flex-direction: column; }
.category-controls .unity-base-field__label { min-width: 0; font-size: 18px; color: rgb(157, 198, 228); }
.category-controls .unity-base-field__input { min-height: 38px; background-color: rgb(19, 38, 55); color: rgb(241, 236, 223); border-width: 1px; border-color: rgb(89, 128, 158); border-radius: 0; font-size: 20px; }
.dungeon-stage-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
.series-cards { flex-direction: column; }
.dungeon-card { min-height: 214px; flex-shrink: 0; margin-bottom: 16px; padding: 0; overflow: hidden; border-width: 2px; border-left-width: 6px; border-color: rgb(113, 162, 199); background-color: rgb(8, 18, 29); background-image: url("../Art/UI/DungeonEntry/ArenaBackground.png"); -unity-background-scale-mode: scale-and-crop; transition-property: border-color, translate; transition-duration: 180ms; }
.dungeon-card:hover, .dungeon-card:focus, .dungeon-card.selected { border-color: rgb(255, 65, 57); }
.dungeon-card:hover { translate: 0 -2px; }
.card-copy { width: 100%; min-width: 0; flex-grow: 1; padding: 20px 24px; background-color: rgba(8, 18, 29, .9); justify-content: center; }
.card-copy Label { -unity-text-align: middle-left; }
.card-title { font-size: 44px; white-space: normal; margin-bottom: 2px; }
.stage-series { font-size: 20px; color: rgb(157, 198, 228); margin-bottom: 12px; white-space: normal; }
.availability { align-self: flex-start; padding: 4px 10px; margin-bottom: 10px; font-size: 20px; color: rgb(255, 241, 224); background-color: rgba(155, 36, 46, .85); white-space: normal; }
.route-info { font-size: 22px; color: rgb(170, 215, 243); white-space: normal; }
.browser-status { flex-shrink: 0; color: rgb(250, 205, 150); margin-top: 10px; }
.dungeon-selection { width: 42%; min-width: 0; min-height: 0; }
.dungeon-stage-preview { flex-grow: 1; flex-basis: 0; min-height: 0; overflow: hidden; }
.selection-title { font-size: 34px; white-space: normal; margin-bottom: 12px; flex-shrink: 0; }
.stage-filter { flex-shrink: 0; }
.stage-filter .section-heading { font-size: 18px; margin-bottom: 4px; }
.stage-filter-controls { padding: 0; margin-bottom: 8px; background-color: rgba(0, 0, 0, 0); }
.difficulty-control { flex-direction: row; align-items: center; margin-bottom: 8px; flex-shrink: 0; }
.difficulty-control Label { font-size: 24px; }
#difficulty-slider { flex-grow: 1; margin: 0 20px; min-width: 0; height: 36px; }
#difficulty-slider .unity-base-slider__tracker { height: 10px; border-radius: 8px; background-color: rgb(63, 80, 98); }
#difficulty-slider .unity-base-slider__dragger { width: 24px; height: 24px; border-radius: 16px; border-width: 3px; border-color: rgb(255, 245, 221); background-color: rgb(230, 36, 48); margin-top: -7px; }
.difficulty-copy { margin-bottom: 10px; font-size: 16px; flex-shrink: 0; }
.stage-overview { flex-grow: 1; flex-basis: 0; min-height: 0; justify-content: center; }
.stage-overview .section-heading { font-size: 24px; margin-bottom: 10px; }
.stage-overview .body-copy { font-size: 18px; }
.selection-arena { width: 100%; max-width: 610px; height: 112px; overflow: hidden; flex-shrink: 0; margin-bottom: 20px; align-self: center; }
.selection-arena-atlas { position: absolute; left: -1035px; top: -170px; width: 1672px; height: 941px; background-image: url("../Art/UI/DungeonEntry/ReferenceAtlas.png"); -unity-background-scale-mode: stretch-to-fill; }
.reward-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 10px; flex-shrink: 0; }
.reward-diamond { width: 44px; height: 44px; margin-right: 12px; background-image: url("../Art/UI/Currency/Diamond.png"); -unity-background-scale-mode: scale-to-fit; }
.reward-copy { flex-grow: 1; margin-right: 12px; }
.reward-preview { font-size: 28px; color: rgb(255, 226, 162); }
.reward-copy .condensed { font-size: 18px; color: rgb(159, 197, 223); }
.preview-button { min-height: 46px; padding: 8px 16px; }
.enter-button { flex-shrink: 0; margin-top: 18px; min-height: 96px; font-size: 48px; }
.entry-lock-note { flex-shrink: 0; -unity-text-align: middle-center; margin-top: 12px; }
.entry-status { flex-shrink: 0; -unity-text-align: middle-center; font-size: 17px; margin-top: 8px; color: rgb(247, 211, 157); }
.preview-summary { margin-top: 12px; }
.dungeon-preview-dialog #dungeon-preview-grid { margin: 16px 0; }
#dungeon-fighters-scroll { flex-grow: 1; flex-basis: 0; min-height: 100px; }
#dungeon-preview-grid .character-grid-card { width: 94px; height: 136px; min-height: 0; padding: 4px; }
#dungeon-preview-grid #character-icon { width: 84px; height: 84px; }
.stage-mode-field { flex-direction: column; flex-shrink: 0; margin-bottom: 10px; }
.stage-mode-field .unity-base-field__label { color: rgb(157, 198, 228); font-size: 18px; }
.stage-mode-field .unity-base-field__input { min-height: 36px; background-color: rgb(19, 38, 55); color: rgb(241, 236, 223); font-size: 20px; }
#cancel-configuration { flex-shrink: 0; margin-top: 16px; }
.compact-layout .headline { margin-bottom: 12px; }
.compact-layout .headline Label { font-size: 48px; }
.compact-layout .dungeon-browser { width: 48%; padding-right: 20px; }
.compact-layout .dungeon-selection { width: 52%; }
.compact-layout .card-copy { padding: 16px; }
.compact-layout .card-title { font-size: 32px; }
.compact-layout .dungeon-stage-preview { padding: 10px; }
.compact-layout .selection-title { font-size: 24px; margin-bottom: 6px; }
.compact-layout .stage-filter .section-heading { font-size: 16px; margin-bottom: 0; }
.compact-layout .stage-filter-controls { margin-bottom: 6px; }
.compact-layout .stage-filter-controls .unity-base-field__label { font-size: 14px; }
.compact-layout .stage-filter-controls .unity-base-field__input { min-height: 30px; height: 30px; padding: 0 8px; font-size: 16px; }
.compact-layout .difficulty-control { margin-bottom: 4px; }
.compact-layout .difficulty-control Label { font-size: 20px; }
.compact-layout #difficulty-slider { height: 28px; }
.compact-layout .stage-overview .section-heading { font-size: 20px; margin-bottom: 6px; }
.compact-layout .stage-overview .body-copy { font-size: 16px; }
.compact-layout .selection-arena { height: 72px; margin-bottom: 12px; }
.compact-layout .reward-row { margin-top: 6px; }
.compact-layout .reward-diamond { width: 34px; height: 34px; }
.compact-layout .reward-copy .condensed { font-size: 14px; }
.compact-layout .preview-button { min-height: 38px; padding: 6px 12px; font-size: 22px; }
.compact-layout .enter-button { min-height: 60px; margin-top: 10px; font-size: 34px; }
.compact-layout .entry-lock-note { display: none; }
.compact-layout .entry-status { font-size: 14px; margin-top: 6px; }
.compact-layout .difficulty-copy { display: none; }
.compact-layout .reward-preview { font-size: 24px; }
.narrow-layout .headline Label { font-size: 44px; margin-right: 14px; }
.narrow-layout .dungeon-browser { width: 100%; padding-right: 0; height: 26%; flex-shrink: 0; margin-bottom: 14px; }
.narrow-layout .dungeon-selection { width: 100%; flex-grow: 1; flex-basis: 0; }
.narrow-layout .dungeon-card { min-height: 194px; }
.narrow-layout .enter-button { min-height: 60px; font-size: 30px; }
.narrow-layout .entry-status { font-size: 14px; margin-top: 4px; }
/* Reward samples stay on Stage Info; the Preview action is only for the fighter roster. */
.reward-row { flex-direction: column; align-items: stretch; }
.reward-copy { margin-right: 0; margin-bottom: 4px; }
.reward-front-scroll { max-height: 182px; min-height: 84px; flex-shrink: 1; }
.dungeon-front-rewards .item-reward-tile { width: 74px; height: 82px; min-height: 0; padding: 4px; margin: 2px; }
.dungeon-front-rewards .item-reward-name { display: none; }
.dungeon-front-rewards .item-reward-frame { width: 66px; height: 66px; }
.preview-button { align-self: flex-end; margin-top: 6px; }
#difficulty-value { width: 164px; -unity-text-align: middle-right; }
.stage-overview .body-copy { display: none; }
.compact-layout .selection-arena { height: 52px; margin-bottom: 8px; }
.compact-layout .reward-copy .condensed { font-size: 12px; }
.compact-layout .reward-front-scroll { min-height: 66px; max-height: 136px; }
.compact-layout .dungeon-front-rewards .item-reward-tile { width: 58px; height: 64px; min-height: 0; padding: 3px; margin: 2px; }
.compact-layout .dungeon-front-rewards .item-reward-frame { width: 52px; height: 52px; }
.compact-layout #difficulty-value { width: 136px; font-size: 19px; }
.narrow-layout .reward-front-scroll { max-height: 150px; }
/* Content rows retain their height inside the fitted preview panel. */
.stage-overview { flex-grow: 0; flex-basis: auto; flex-shrink: 0; min-height: auto; justify-content: flex-start; margin-top: 8px; }
.stage-mode-field { height: 60px; margin-bottom: 8px; }
.stage-mode-field .unity-base-field__label { min-height: 22px; height: 22px; }
.stage-mode-field .unity-base-field__input { min-height: 36px; height: 36px; flex-shrink: 0; }
.selection-arena { height: 74px; margin-bottom: 8px; }
.stage-overview .section-heading { font-size: 20px; margin-bottom: 6px; flex-shrink: 0; }
.compact-layout .stage-overview { margin-top: 4px; }
.compact-layout .stage-mode-field { height: 50px; margin-bottom: 6px; }
.compact-layout .stage-mode-field .unity-base-field__label { font-size: 14px; min-height: 18px; height: 18px; }
.compact-layout .stage-mode-field .unity-base-field__input { min-height: 30px; height: 30px; font-size: 16px; }
.compact-layout .selection-arena { display: none; }
.compact-layout .stage-overview .section-heading { font-size: 16px; margin-bottom: 6px; }
.stage-overview-row { flex-direction: row; align-items: center; height: 66px; flex-shrink: 0; margin-bottom: 8px; }
.stage-overview-row .stage-mode-field { flex-grow: 1; flex-basis: 0; min-width: 0; margin-bottom: 0; }
.stage-overview-row .selection-arena { width: 42%; height: 62px; margin-left: 14px; margin-bottom: 0; }
.compact-layout .stage-overview-row { height: 50px; margin-bottom: 6px; }

/* Readable reward categories, with a Flower for each eligible artifact set. */
.artifact-basket-label { flex-shrink: 0; margin: 5px 0; font-size: 20px; color: rgb(163, 221, 190); }
.reward-front-scroll { min-height: 130px; max-height: 270px; }
.dungeon-front-rewards .item-reward-tile { width: 124px; height: 124px; min-height: 124px; padding: 4px; margin: 3px; }
.dungeon-front-rewards .item-reward-frame { width: 112px; height: 112px; }
.dungeon-front-rewards .artifact-item-tile .item-reward-icon { position: absolute; left: 4px; right: 4px; top: 4px; bottom: 38px; width: auto; height: auto; }
.compact-layout .artifact-basket-label { font-size: 16px; margin: 3px 0; }
.compact-layout .reward-front-scroll { min-height: 100px; max-height: 210px; }
.compact-layout .dungeon-front-rewards .item-reward-tile { width: 90px; height: 94px; min-height: 94px; padding: 3px; margin: 2px; }
.compact-layout .dungeon-front-rewards .item-reward-frame { width: 82px; height: 82px; }
.narrow-layout .reward-front-scroll { min-height: 110px; max-height: 232px; }
.narrow-layout .dungeon-front-rewards .item-reward-tile { width: 106px; height: 110px; min-height: 110px; margin: 2px; padding: 4px; }
.narrow-layout .dungeon-front-rewards .item-reward-frame { width: 96px; height: 96px; }

/* The category preview and both set Flowers fit one row. It has no ScrollView and never wraps. */
.reward-front-scroll { height: 124px; min-height: 124px; max-height: 124px; flex-shrink: 0; }
.dungeon-front-rewards { width: 100%; flex-direction: row; flex-wrap: nowrap; min-width: 0; }
.dungeon-front-rewards .item-reward-tile { width: auto; flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; height: 116px; min-height: 116px; margin: 3px; }
.dungeon-front-rewards .item-reward-frame { width: 100%; height: 100px; }
.compact-layout .reward-front-scroll { height: 98px; min-height: 98px; max-height: 98px; }
.compact-layout .dungeon-front-rewards .item-reward-tile { width: auto; min-width: 0; height: 92px; min-height: 92px; }
.compact-layout .dungeon-front-rewards .item-reward-frame { width: 100%; height: 82px; }
.narrow-layout .reward-front-scroll { height: 110px; min-height: 110px; max-height: 110px; }
.narrow-layout .dungeon-front-rewards .item-reward-tile { width: auto; min-width: 0; height: 104px; min-height: 104px; }
.narrow-layout .dungeon-front-rewards .item-reward-frame { width: 100%; height: 94px; }

/* Roster action shares the heading row, keeping it visible above the fitted rewards. */
.reward-heading-row { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; }
.reward-heading-row .reward-preview { flex-grow: 1; min-width: 0; }
.reward-heading-row .preview-button { align-self: center; flex-shrink: 0; margin-top: 0; }
.compact-layout .reward-heading-row .preview-button { min-height: 32px; padding: 4px 10px; font-size: 19px; }

.dungeon-front-rewards .artifact-preview-tile .item-reward-icon { bottom: 22px; }

.dungeon-browser { width: 54%; }
.dungeon-selection { width: 46%; }
.compact-layout .dungeon-browser { width: 35%; }
.compact-layout .dungeon-selection { width: 65%; }
.reward-front-scroll, .compact-layout .reward-front-scroll { height: 108px; min-height: 108px; max-height: 108px; }

.reward-front-scroll, .compact-layout .reward-front-scroll { height: 128px; min-height: 128px; max-height: 128px; }
