<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ArtifactLoadout" src="project://database/Assets/Project/Resources/UI/ArtifactLoadout.uxml?fileID=9197481963319205126&amp;guid=361f7043f36f446a8c0b837bb8890424&amp;type=3#ArtifactLoadout"/>
    <ui:Template name="BattleCard" src="project://database/Assets/Project/UI/BattleCard.uxml?fileID=9197481963319205126&amp;guid=c61f3b08657e4af9ab8610c92c24b7e3&amp;type=3#BattleCard"/>
    <Style src="project://database/Assets/Project/UI/CharacterHub.uss?fileID=7433441132597879392&amp;guid=22036dd60b324bcbbebdd019162f64a1&amp;type=3#CharacterHub"/>
    <ui:VisualElement class="hub-page">
        <ui:VisualElement picking-mode="Ignore" class="hub-background" style="background-image: none; background-color: rgba(29, 29, 29, 0.88);"/>
        <ui:VisualElement picking-mode="Ignore" class="hub-background-tint"/>
        <ui:VisualElement class="hub-hero" style="width: 50%;">
            <ui:Image name="hub-portrait" picking-mode="Ignore" class="hub-portrait"/>
        </ui:VisualElement>
        <ui:VisualElement class="hub-details" style="padding-left: 28px; padding-right: 20px;">
            <ui:VisualElement class="hub-tabs">
                <ui:Button name="hub-tab-kit" text="CHARACTER KIT" class="hub-tab heavy"/>
                <ui:Button name="hub-tab-upgrade" text="UPGRADE" class="hub-tab heavy"/>
                <ui:Button name="hub-tab-constellation" text="CONSTELLATION" class="hub-tab heavy"/>
                <ui:Button name="hub-tab-artifacts" text="ARTIFACTS" tooltip="Equip and enhance artifacts" class="hub-tab heavy"/>
            </ui:VisualElement>
            <ui:ScrollView name="hub-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="hub-scroll">
                <ui:VisualElement name="hub-page-kit" class="hub-tab-page" style="display: none;">
                    <ui:VisualElement class="hub-identity" style="position: relative; left: auto; right: auto; bottom: auto; margin-bottom: 10px; background-color: rgba(8, 15, 25, 0.2);">
                        <ui:VisualElement class="hub-identity-copy">
                            <ui:Label name="hub-name" text="FIGHTER" class="hub-name heavy"/>
                            <ui:Label name="hub-meta" class="hub-meta condensed"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-card hub-column" style="background-color: rgba(8, 18, 31, 0);">
                        <ui:VisualElement class="hub-panel-heading">
                            <ui:Label name="hub-kit-level" class="hub-page-title heavy"/>
                            <ui:Button name="hub-stat-details" text="DETAILS  ›" class="action-button"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="hub-stats" class="basic-stat-preview"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-card hub-column" style="background-color: rgba(8, 18, 31, 0); height: 323px;">
                        <ui:Label text="CHARACTER KIT" class="hub-card-title heavy"/>
                        <ui:VisualElement name="hub-kit-icons" class="hub-kit-icons" style="justify-content: center;">
                            <ui:Instance template="BattleCard" name="hub-card-1" class="hub-kit-card" style="width: 136.8px; height: 218.4px;"/>
                            <ui:Instance template="BattleCard" name="hub-card-2" class="hub-kit-card" style="width: 136.8px; height: 218.4px;"/>
                            <ui:Instance template="BattleCard" name="hub-card-0" class="hub-kit-card ultimate-card" style="width: 136.8px; height: 218.4px;"/>
                            <ui:Button name="hub-passive-button" tooltip="Inspect passive" class="hub-passive-icon" style="width: 120px; height: 120px;">
                                <ui:Image name="hub-passive-image" picking-mode="Ignore"/>
                                <ui:Label text="P" picking-mode="Ignore" class="hub-passive-marker"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hub-page-upgrade" class="hub-tab-page hub-upgrade-page" style="display: flex; background-color: rgba(7, 19, 34, 0);">
                    <ui:VisualElement class="hub-upgrade-preview">
                        <ui:Label name="hub-upgrade-title" text="LEVEL UP" class="hub-page-title heavy"/>
                        <ui:Label name="hub-upgrade-fighter" class="hub-upgrade-fighter"/>
                        <ui:VisualElement class="hub-upgrade-level-row">
                            <ui:Label name="hub-current-level" class="hub-upgrade-level heavy"/>
                            <ui:Label name="hub-upgrade-cap-preview" class="hub-upgrade-cap-preview"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="hub-upgrade-stats" class="basic-stat-preview"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-upgrade-controls">
                        <ui:VisualElement name="hub-upgrade-material-section" class="hub-upgrade-material-section">
                            <ui:Label text="REQUIRED MATERIALS" class="hub-upgrade-material-title heavy" style="-unity-text-align: upper-center; margin-bottom: 10px;"/>
                            <ui:VisualElement name="hub-upgrade-materials" class="item-reward-grid hub-materials"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-upgrade-action-row" style="background-color: rgba(0, 0, 0, 0);">
                            <ui:VisualElement name="hub-upgrade-coin-icon" class="hub-upgrade-coin-icon account-coin" style="margin-left: 20px; width: 50px; height: 50px;"/>
                            <ui:VisualElement class="hub-upgrade-coin-copy">
                                <ui:Label name="hub-upgrade-coin-cost" class="hub-upgrade-coin-cost heavy"/>
                                <ui:Label name="hub-upgrade-coin-owned" class="hub-upgrade-coin-owned"/>
                            </ui:VisualElement>
                            <ui:Button name="hub-upgrade-action" text="LEVEL UP" class="action-button primary-action"/>
                        </ui:VisualElement>
                        <ui:Label name="hub-upgrade-result" class="hub-upgrade-result" style="display: none;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hub-page-constellation" class="hub-tab-page" style="display: none;">
                    <ui:Label text="CONSTELLATION" class="hub-page-title heavy"/>
                    <ui:Label text="Choose a state to inspect its authored ultimate. Your current state stays unchanged." class="hub-note condensed"/>
                    <ui:VisualElement name="hub-constellation-track" class="hub-constellation-track">
                        <ui:VisualElement class="hub-node">
                            <ui:Button name="hub-constellation-0" text="C0" class="hub-node-button unlocked selected"/>
                            <ui:Label name="hub-node-state-0" text="CURRENT" class="hub-node-state condensed"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-node">
                            <ui:Button name="hub-constellation-1" text="C1" class="hub-node-button"/>
                            <ui:Label name="hub-node-state-1" text="LOCKED" class="hub-node-state condensed"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-node">
                            <ui:Button name="hub-constellation-2" text="C2" class="hub-node-button"/>
                            <ui:Label name="hub-node-state-2" text="LOCKED" class="hub-node-state condensed"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-node">
                            <ui:Button name="hub-constellation-3" text="C3" class="hub-node-button"/>
                            <ui:Label name="hub-node-state-3" text="LOCKED" class="hub-node-state condensed"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-node">
                            <ui:Button name="hub-constellation-4" text="C4" class="hub-node-button"/>
                            <ui:Label name="hub-node-state-4" text="LOCKED" class="hub-node-state condensed"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="hub-node">
                            <ui:Button name="hub-constellation-5" text="C5" class="hub-node-button"/>
                            <ui:Label name="hub-node-state-5" text="LOCKED" class="hub-node-state condensed"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-card hub-column">
                        <ui:Label name="hub-current-constellation" class="hub-eyebrow condensed"/>
                        <ui:Label name="hub-current-ultimate" class="hub-rules"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-card hub-column hub-ultimate">
                        <ui:Label name="hub-preview-constellation" class="hub-card-title heavy"/>
                        <ui:Label name="hub-preview-ultimate" class="hub-rules"/>
                    </ui:VisualElement>
                    <ui:Button text="UNLOCK CONSTELLATION · PREVIEW ONLY" enabled="false" class="action-button primary-action hub-deferred"/>
                </ui:VisualElement>
                <ui:VisualElement name="hub-page-artifacts" class="hub-tab-page" style="display: none;">
                    <ui:Instance template="ArtifactLoadout"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
