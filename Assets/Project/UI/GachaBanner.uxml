<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="FrontEnd.uss" />
    <ui:VisualElement class="front-root">
        <ui:VisualElement class="top-bar"><ui:Button name="back" text="← HOME" /><ui:Label text="SUMMON" class="brand" /><ui:Label name="wallet" class="wallet" /><ui:Button name="battle" text="Choose dungeon →" /></ui:VisualElement>
        <ui:VisualElement name="banner-screen" class="banner-screen">
            <ui:VisualElement class="banner-body">
                <ui:VisualElement class="banner-rail"><ui:Label text="KOF" class="banner-tab" /><ui:Label text="FIGHTERS" /></ui:VisualElement>
                <ui:VisualElement class="banner-art">
                    <ui:VisualElement class="banner-copy"><ui:Label text="KOF FIGHTER SUMMON" class="eyebrow" /><ui:Label text="THE KING&#10;OF FIGHTERS" class="hero-title" /><ui:Label text="Assemble your all-star team." class="body-copy" /><ui:Label text="SSR 4%  ·  SR 36%  ·  R 60%" class="body-copy" /><ui:Label name="guarantee" class="body-copy" /></ui:VisualElement>
                    <ui:Image name="hero-art" class="hero-art" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="details-panel" class="details-panel" style="display: none;" />
            <ui:VisualElement class="banner-actions"><ui:Button name="details" text="Details &amp; rates" /><ui:Button name="selector" text="Featured selector" /><ui:VisualElement class="spacer" /><ui:Button name="summon-one" text="Summon ×1&#10;160 Diamonds" class="summon-button" /><ui:Button name="summon-ten" text="Summon ×10&#10;1,600 Diamonds" class="summon-button" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="result-screen" class="result-screen" style="display: none;"><ui:Label name="result-title" class="brand" /><ui:ScrollView><ui:VisualElement name="result-cards" class="result-cards" /></ui:ScrollView><ui:Button name="result-close" text="Continue" class="summon-button" /></ui:VisualElement>
        <ui:Label name="notice" class="footer-copy" />
    </ui:VisualElement>
</ui:UXML>
