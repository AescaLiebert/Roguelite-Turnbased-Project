<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="AccountHeader" src="project://database/Assets/Project/Resources/UI/AccountHeader.uxml?fileID=9197481963319205126&amp;guid=48842567732fe4840bdbaeeeaa1ebcf8&amp;type=3#AccountHeader"/>
    <Style src="project://database/Assets/Project/UI/GachaBanner.uss?fileID=7433441132597879392&amp;guid=fe01d8754f1b593409f0a59ae7a62bdf&amp;type=3#GachaBanner"/>
    <ui:VisualElement name="gacha-viewport" class="screen-root gacha-viewport">
        <ui:VisualElement name="gacha-stage" class="screen-stage gacha-stage">
            <ui:VisualElement picking-mode="Ignore" class="screen-background gacha-background" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/MainMenu-Background.png?fileID=2800000&amp;guid=182edc30b511c6044b83664b0c59729a&amp;type=3#MainMenu-Background&quot;);"/>
            <ui:Instance template="AccountHeader" class="account-header-instance">
                <AttributeOverrides element-name="section-title" text="SUMMON"/>
            </ui:Instance>
            <ui:VisualElement name="banner-screen" class="screen-body gacha-layout">
                <ui:VisualElement class="banner-navigation">
                    <ui:Label text="BANNERS" class="banner-list-heading condensed"/>
                    <ui:ScrollView name="banner-list-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="banner-list-scroll">
                        <ui:VisualElement name="banner-list-grid" class="banner-list-grid"/>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="gacha-content">
                    <ui:VisualElement name="banner-promotion" class="banner-promotion">
                        <ui:VisualElement name="banner-artwork" picking-mode="Ignore" class="banner-artwork"/>
                        <ui:Image name="hero-art" picking-mode="Ignore" class="banner-hero"/>
                        <ui:VisualElement class="gacha-copy">
                            <ui:Label text="FIGHTER SUMMON" class="banner-eyebrow condensed"/>
                            <ui:Label name="banner-title" class="banner-title heavy"/>
                            <ui:Label name="banner-description" class="banner-description condensed" style="display: none;"/>
                            <ui:Label text="POOL PREVIEW" class="banner-preview-heading condensed"/>
                            <ui:VisualElement name="gacha-preview-grid" class="character-grid"/>
                            <ui:Button name="selector" class="action-button gacha-guarantee-button">
                                <ui:Label name="guarantee" text="SSR SELECTOR" picking-mode="Ignore" class="condensed"/>
                                <ui:Label name="guarantee-value" picking-mode="Ignore" class="guarantee-value condensed"/>
                                <ui:VisualElement picking-mode="Ignore" class="gacha-progress-track">
                                    <ui:VisualElement name="guarantee-fill" class="gacha-progress-fill"/>
                                </ui:VisualElement>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="banner-actions" class="gacha-toolbar">
                        <ui:Button name="details" text="DETAILS  ›" class="action-button gacha-details-button"/>
                        <ui:VisualElement class="gacha-pull-actions">
                            <ui:Button name="summon-one" class="action-button gacha-pull-button single-pull">
                                <ui:VisualElement picking-mode="Ignore" class="pull-diamond"/>
                                <ui:Label name="summon-one-label" picking-mode="Ignore" class="condensed-heavy"/>
                            </ui:Button>
                            <ui:Button name="summon-ten" class="action-button primary-action gacha-pull-button ten-pull">
                                <ui:VisualElement picking-mode="Ignore" class="pull-diamond"/>
                                <ui:Label name="summon-ten-label" picking-mode="Ignore" class="condensed-heavy"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="notice" class="gacha-notice body-copy" style="display: none;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="details-overlay" class="modal-scrim" style="display: none;">
            <ui:VisualElement class="modal-dialog">
                <ui:VisualElement class="modal-toolbar">
                    <ui:Label name="details-title" text="RATES &amp; DETAILS" class="modal-title"/>
                    <ui:Button name="details-close" text="CLOSE" class="action-button"/>
                </ui:VisualElement>
                <ui:ScrollView name="details-panel" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="modal-scroll gacha-details-panel" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
