<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="DungeonEntry.uss" />
    <ui:VisualElement class="entry-root">
        <ui:VisualElement name="series-browser" class="series-browser">
            <ui:VisualElement class="entry-header">
                <ui:Button name="back-menu" text="← HOME" class="quiet-button" />
                <ui:VisualElement><ui:Label text="BATTLE / DUNGEONS" class="eyebrow" /><ui:Label text="Choose a dungeon" class="entry-title" /></ui:VisualElement>
                <ui:Label text="SELECT SERIES" class="header-hint" />
            </ui:VisualElement>
            <ui:ScrollView name="series-cards" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" class="series-cards" />
            <ui:Label name="series-status" text="Select a series to configure your dungeon." class="browser-status" />
        </ui:VisualElement>
        <ui:VisualElement name="configuration-overlay" class="configuration-overlay" style="display: none;">
            <ui:VisualElement class="configuration-dialog">
                <ui:VisualElement class="dialog-header"><ui:VisualElement><ui:Label text="RUN CONFIGURATION" class="eyebrow" /><ui:Label name="configuration-title" text="KOF / DUNGEON" class="dialog-title" /></ui:VisualElement><ui:Button name="close-configuration" text="×" tooltip="Close configuration" class="close-button" /></ui:VisualElement>
                <ui:ScrollView class="configuration-body">
                    <ui:Label text="PHASE" class="section-title" />
                    <ui:DropdownField name="phase-filter" label="Release phase" />
                    <ui:DropdownField name="subphase-filter" label="Sub-phase" />
                    <ui:Label name="profile-description" class="entry-copy" />
                    <ui:VisualElement class="difficulty-panel">
                        <ui:Label text="DIFFICULTY &amp; REWARD" class="section-title" />
                        <ui:Label name="difficulty-value" text="+0% enemy strength" class="difficulty-value" />
                        <ui:SliderInt name="difficulty-slider" low-value="0" high-value="100" value="0" page-size="5" />
                        <ui:Label name="reward-preview" text="Completion reward · 320 Diamonds" class="reward-preview" />
                        <ui:Label text="Higher difficulty increases enemy strength and the completion reward. Difficulty is fixed when you enter." class="entry-copy" />
                    </ui:VisualElement>
                    <ui:Label name="entry-status" class="entry-status" />
                </ui:ScrollView>
                <ui:VisualElement class="dialog-footer"><ui:Button name="cancel-configuration" text="Cancel" class="quiet-button" /><ui:Button name="start-run-button" text="ENTER DUNGEON  →" class="primary-button" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
