.economy-root { flex-grow: 1; min-height: 100%; padding: 28px; background-color: rgb(12, 17, 26); color: rgb(236, 241, 248); }
.header-row { flex-direction: row; justify-content: space-between; align-items: center; }
.eyebrow { color: rgb(100, 190, 208); font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; }
.page-title { margin-top: 4px; font-size: 30px; -unity-font-style: bold; }
.local-badge { margin-top: 5px; color: rgb(174, 186, 202); font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; }
.wallet-panel { min-width: 245px; padding: 12px 16px; background-color: rgb(25, 33, 47); border-left-width: 3px; border-left-color: rgb(232, 183, 81); }
.wallet-value { color: rgb(255, 218, 128); font-size: 15px; -unity-font-style: bold; }
.small-copy { margin-top: 7px; color: rgb(163, 176, 196); font-size: 11px; white-space: normal; }
.warning-copy { margin-top: 18px; padding: 11px; background-color: rgb(64, 45, 31); color: rgb(255, 213, 164); font-size: 12px; white-space: normal; }
.summary-row { flex-direction: row; margin-top: 12px; }
.summary-chip { margin-right: 8px; padding: 8px 12px; background-color: rgb(26, 37, 52); color: rgb(190, 210, 229); font-size: 12px; }
.tabs { flex-direction: row; margin-top: 18px; border-bottom-width: 1px; border-bottom-color: rgb(50, 63, 81); }
.tab-button { margin-right: 6px; padding: 10px 18px; background-color: rgb(30, 43, 61); color: rgb(220, 230, 241); border-bottom-width: 2px; border-bottom-color: rgb(76, 145, 172); }
.content-panel { margin-top: 12px; padding: 16px; background-color: rgb(21, 28, 40); }
.pool-row { flex-direction: row; align-items: center; min-height: 43px; padding: 7px 4px; border-bottom-width: 1px; border-bottom-color: rgb(45, 56, 71); }
.pool-name { flex-grow: 1; font-size: 13px; -unity-font-style: bold; }
.pool-rate { width: 70px; color: rgb(255, 214, 123); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-right; }
.draft-badge { min-width: 205px; color: rgb(239, 180, 118); font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-right; }
.banner-actions { margin-top: 12px; padding: 16px; background-color: rgb(25, 33, 47); }
.policy-copy { color: rgb(192, 201, 216); font-size: 12px; white-space: normal; }
.summon-buttons { flex-direction: row; justify-content: center; margin-top: 14px; }
.primary-button { min-height: 42px; margin: 4px; padding: 10px 18px; background-color: rgb(128, 75, 39); color: rgb(255, 243, 219); border-bottom-width: 2px; border-bottom-color: rgb(238, 177, 91); -unity-font-style: bold; }
.secondary-button { min-height: 36px; margin: 4px; padding: 8px 13px; background-color: rgb(37, 52, 72); color: rgb(220, 232, 244); border-bottom-width: 1px; border-bottom-color: rgb(79, 127, 155); }
.results-panel { margin-top: 12px; }
.panel-title { margin-bottom: 8px; color: rgb(244, 207, 127); font-size: 15px; -unity-font-style: bold; }
.body-copy { color: rgb(204, 214, 228); font-size: 12px; white-space: normal; }
.rate-line { margin-bottom: 8px; padding: 7px 0; color: rgb(251, 221, 164); font-size: 15px; -unity-font-style: bold; }
.collection-list { margin-top: 8px; }
.formation-list { margin-top: 12px; max-width: 560px; }
.formation-slot { margin-bottom: 10px; padding: 10px 12px; background-color: rgb(26, 37, 52); }
.collection-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 44px; border-bottom-width: 1px; border-bottom-color: rgb(45, 56, 71); }
.collection-name { flex-grow: 1; margin-right: 8px; color: rgb(212, 222, 235); font-size: 12px; white-space: normal; }
.selector-heading { margin-top: 20px; }
.selector-list { margin-top: 5px; }
.selector-title { margin-top: 8px; color: rgb(255, 215, 139); font-size: 12px; -unity-font-style: bold; }
.modal-panel { margin-top: 12px; padding: 16px; background-color: rgb(44, 38, 29); border-left-width: 3px; border-left-color: rgb(236, 184, 93); }
.modal-actions { flex-direction: row; justify-content: flex-end; margin-top: 10px; }
.notice-copy { margin-top: 14px; color: rgb(145, 162, 184); font-size: 11px; white-space: normal; }
