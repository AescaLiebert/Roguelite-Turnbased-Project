<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="FrontEnd.uss" />
    <ui:VisualElement class="front-root">
        <ui:VisualElement class="top-bar"><ui:Label text="FIGHTING ALLSTAR" class="brand" /><ui:Label name="wallet" class="wallet" /></ui:VisualElement>
        <ui:VisualElement class="main-body">
            <ui:Image name="hero-art" class="hero-art" />
            <ui:VisualElement class="menu-copy">
                <ui:Label text="KOF / LABYRINTH" class="eyebrow" />
                <ui:Label text="Choose your fighters.&#10;Find your way." class="hero-title" />
                <ui:Label text="Build a team and take on a new dungeon route." class="body-copy" />
                <ui:Button name="battle" text="BATTLE  →" class="battle-button" />
                <ui:Button name="summon" text="SUMMON FIGHTERS" class="secondary-button" />
                <ui:Button name="training" text="TRAINING MODE" class="secondary-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Your collection stays with you. Each dungeon is a fresh run." class="footer-copy" />
    </ui:VisualElement>
</ui:UXML>
