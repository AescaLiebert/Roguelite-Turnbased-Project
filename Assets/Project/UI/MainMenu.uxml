<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="AccountHeader" src="project://database/Assets/Project/Resources/UI/AccountHeader.uxml?fileID=9197481963319205126&amp;guid=48842567732fe4840bdbaeeeaa1ebcf8&amp;type=3#AccountHeader"/>
    <ui:Template name="CharacterHub" src="project://database/Assets/Project/UI/CharacterHub.uxml?fileID=9197481963319205126&amp;guid=74baf65dec0f45b79b33f97766ac1989&amp;type=3#CharacterHub"/>
    <ui:Template name="CharacterInventory" src="project://database/Assets/Project/UI/CharacterInventory.uxml?fileID=9197481963319205126&amp;guid=adcd4876974d4a55be5a1828ba65c810&amp;type=3#CharacterInventory"/>
    <Style src="project://database/Assets/Project/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=6b0ce8f0cd1b4e5c9c1762f831f4a8d7&amp;type=3#MainMenu"/>
    <ui:VisualElement name="menu-viewport" class="screen-root menu-viewport">
        <ui:VisualElement name="menu-stage" class="screen-stage menu-stage">
            <ui:VisualElement picking-mode="Ignore" class="screen-background arena-background" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/MainMenu-Background.png?fileID=2800000&amp;guid=182edc30b511c6044b83664b0c59729a&amp;type=3#MainMenu-Background&quot;); background-size: contain; top: 0; right: 0; bottom: 0; left: 0;"/>
            <ui:VisualElement name="hero-stage" picking-mode="Ignore" class="screen-background hero-stage">
                <ui:Image name="hero-art" picking-mode="Ignore" class="hero-art"/>
            </ui:VisualElement>
            <ui:Instance template="AccountHeader" class="account-header-instance">
                <AttributeOverrides element-name="section-title" text="HOME"/>
            </ui:Instance>
            <ui:VisualElement name="home-screen" class="screen-body home-body">
                <ui:VisualElement class="home-menu">
                    <ui:VisualElement name="route-card" class="route-card surface-panel" style="display: none;">
                        <ui:VisualElement name="route-art" picking-mode="Ignore" class="route-art">
                            <ui:Label name="route-series" class="route-series condensed"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="route-copy">
                            <ui:Label text="CURRENT DUNGEON" class="route-eyebrow condensed"/>
                            <ui:Label name="current-dungeon-name" class="route-title display-heavy"/>
                            <ui:Label name="current-dungeon-stage" class="route-fact display"/>
                            <ui:Label name="current-dungeon-difficulty" class="route-fact display"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="battle" text="ENTER DUNGEON  ›" tooltip="Choose a dungeon" class="action-button primary-action battle-button display-heavy"/>
                    <ui:Button name="summon" tooltip="Open summon banners" class="action-button utility-button summon-button">
                        <ui:VisualElement name="summon-icon" picking-mode="Ignore" class="summon-icon"/>
                        <ui:Label text="SUMMON  ›" picking-mode="Ignore" class="display-heavy"/>
                    </ui:Button>
                    <ui:Button name="character-inventory-open" text="CHARACTERS  ›" tooltip="Browse your owned fighters" class="action-button utility-button inventory-button display-heavy"/>
                    <ui:VisualElement class="home-small-actions">
                        <ui:Button name="training" tooltip="Choose a fighter for practice" class="action-button utility-button training-button">
                            <ui:VisualElement name="training-icon" picking-mode="Ignore" class="training-icon"/>
                            <ui:Label text="PRACTICE  ›" picking-mode="Ignore" class="display-heavy"/>
                        </ui:Button>
                        <ui:Button name="backpack" text="BACKPACK  ›" tooltip="Browse artifacts, materials and character dupes" class="action-button utility-button backpack-button display-heavy"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Instance template="CharacterInventory" name="character-inventory" class="inventory-screen" style="display: none;"/>
            <ui:Instance template="CharacterHub" name="character-hub" class="inventory-screen" style="display: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
