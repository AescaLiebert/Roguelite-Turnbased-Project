.safe-area-root { flex-grow: 1; background-color: rgb(13, 17, 26); color: rgb(238, 242, 248); padding-left: 24px; padding-right: 24px; padding-top: 18px; padding-bottom: 18px; }
.top-bar { height: 58px; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(53, 63, 79); }
.eyebrow { color: rgb(110, 194, 210); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.battle-status { font-size: 20px; -unity-font-style: bold; }
.arena { flex-grow: 1; min-height: 260px; justify-content: space-around; padding-top: 12px; padding-bottom: 12px; }
.side-label { color: rgb(155, 170, 190); font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.opponent-label { align-self: flex-start; }
.player-label { align-self: flex-start; }
.formation { flex-direction: row; justify-content: center; align-items: stretch; min-height: 92px; }
.fighter-card { width: 190px; min-height: 82px; margin-left: 8px; margin-right: 8px; padding: 11px; background-color: rgb(30, 38, 52); border-left-width: 3px; border-left-color: rgb(109, 151, 205); border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
.opponent-formation .fighter-card { border-left-color: rgb(220, 117, 104); }
.fighter-reserve { opacity: 0.72; border-left-color: rgb(190, 160, 91); }
.fighter-defeated { opacity: 0.42; background-color: rgb(39, 39, 43); }
#fighter-name { font-size: 13px; -unity-font-style: bold; white-space: normal; }
#fighter-hp, #fighter-pg { margin-top: 5px; color: rgb(183, 197, 216); font-size: 11px; }
.arena-divider { height: 20px; border-top-width: 1px; border-top-color: rgb(52, 61, 77); align-items: center; }
.versus { position: absolute; left: 50%; top: -10px; background-color: rgb(13, 17, 26); color: rgb(126, 142, 165); padding-left: 8px; padding-right: 8px; font-size: 10px; }
.planning-panel { padding: 14px; background-color: rgb(23, 29, 41); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.section-heading, .hand-heading, .planning-controls { flex-direction: row; align-items: center; justify-content: space-between; }
.section-title { color: rgb(155, 170, 190); font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.action-queue { flex-grow: 1; min-height: 26px; flex-direction: row; justify-content: flex-end; }
.action-queue Label { margin-left: 12px; color: rgb(223, 197, 130); font-size: 11px; }
.hand-heading { margin-top: 9px; }
.hand-tray { height: 108px; flex-direction: row; margin-top: 7px; margin-bottom: 11px; }
.hand-card { width: 150px; min-width: 150px; height: 94px; margin-right: 8px; background-color: rgb(43, 53, 70); color: rgb(238, 242, 248); border-top-width: 1px; border-top-color: rgb(89, 106, 133); border-bottom-width: 3px; border-bottom-color: rgb(81, 148, 169); -unity-text-align: middle-center; white-space: normal; font-size: 11px; }
.card-selected { background-color: rgb(63, 79, 104); border-bottom-color: rgb(223, 197, 130); }
.planning-controls { justify-content: flex-end; }
.quiet-button { min-height: 34px; margin-left: 7px; padding-left: 14px; padding-right: 14px; background-color: rgb(37, 46, 62); color: rgb(212, 222, 235); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
.confirm-button { min-height: 36px; margin-left: 10px; padding-left: 18px; padding-right: 18px; background-color: rgb(49, 128, 146); color: white; -unity-font-style: bold; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
Button:disabled { opacity: 0.42; }
