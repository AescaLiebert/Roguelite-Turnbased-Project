.front-root { flex-grow: 1; background-color: rgb(14, 23, 45); color: rgb(242, 237, 221); padding: 28px; }
.top-bar { flex-direction: row; align-items: center; justify-content: space-between; min-height: 62px; border-bottom-width: 2px; border-bottom-color: rgb(80, 109, 159); }
.brand { font-size: 26px; -unity-font-style: bold; letter-spacing: 2px; }
.wallet { color: rgb(230, 199, 124); font-size: 20px; }
.main-body { flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-around; }
.hero-art { width: 48%; flex-grow: 1; min-height: 280px; -unity-background-scale-mode: scale-to-fit; }
.menu-copy { width: 48%; padding: 32px; }
.eyebrow { color: rgb(122, 207, 226); font-size: 17px; letter-spacing: 2px; }
.hero-title { font-size: 48px; white-space: normal; -unity-font-style: bold; margin-top: 18px; margin-bottom: 24px; }
.body-copy { font-size: 18px; white-space: normal; margin-bottom: 18px; }
Button { min-height: 40px; background-color: rgb(35, 52, 83); color: rgb(246, 239, 219); border-width: 1px; border-color: rgb(86, 107, 145); padding: 10px 20px; border-radius: 6px; font-size: 16px; }
Button:hover { background-color: rgb(60, 82, 119); }
.battle-button { background-color: rgb(166, 49, 63); min-height: 82px; font-size: 32px; -unity-font-style: bold; margin-top: 26px; }
.secondary-button { margin-top: 12px; min-height: 54px; }
.footer-copy { min-height: 34px; margin-top: 14px; color: rgb(166, 185, 213); white-space: normal; font-size: 14px; }
.banner-screen { flex-grow: 1; }
.banner-body { flex-direction: row; flex-grow: 1; margin-top: 26px; }
.banner-rail { width: 100px; align-items: center; padding: 12px; color: rgb(160, 191, 222); }
.banner-tab { background-color: rgb(96, 56, 77); padding: 22px; border-width: 2px; border-color: rgb(227, 191, 119); font-size: 22px; }
.banner-art { flex-direction: row; flex-grow: 1; background-color: rgb(43, 53, 76); border-width: 2px; border-color: rgb(153, 126, 87); border-radius: 14px; padding: 24px; }
.banner-copy { width: 52%; justify-content: center; padding: 16px; }
.banner-actions { flex-direction: row; align-items: center; margin-top: 20px; }
.spacer { flex-grow: 1; }
.summon-button { background-color: rgb(223, 208, 174); color: rgb(38, 43, 61); white-space: normal; min-width: 210px; min-height: 60px; margin-left: 12px; font-size: 20px; }
.details-panel { max-height: 200px; padding: 16px; background-color: rgb(22, 33, 55); }
.details-panel Label { white-space: normal; margin-bottom: 6px; }
.result-screen { flex-grow: 1; justify-content: space-around; align-items: stretch; padding: 24px; }
.result-cards { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.result-card { width: 17%; min-width: 140px; height: 240px; margin: 10px; padding: 0; overflow: hidden; background-color: rgba(0, 0, 0, 0); border-bottom-width: 0; }
.result-card .character-icon { width: 100%; height: 100%; flex-grow: 1; }
.rarity-ssr { border-bottom-color: rgb(239, 190, 88); background-color: rgb(75, 58, 51); }
.rarity-sr { border-bottom-color: rgb(191, 125, 223); }
.loading-message { position: absolute; left: 40%; top: 45%; background-color: rgb(14, 23, 45); padding: 25px; font-size: 24px; }
