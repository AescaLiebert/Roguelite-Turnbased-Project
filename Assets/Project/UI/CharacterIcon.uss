.character-icon { position: relative; width: 100%; height: 100%; overflow: hidden; }
.character-icon-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.rarity-background { scale-mode: stretch-to-fill; }
.portrait { left: 2.5%; top: 2.5%; width: 95%; height: 95%; scale-mode: scale-and-crop; }
.rarity-frame { scale-mode: scale-to-fit; }
.attribute-icon { position: absolute; right: 2%; top: 2%; width: 25%; height: 25%; scale-mode: scale-to-fit; }
.rarity-label { position: absolute; left: -2%; bottom: -2%; width: 39%; height: 39%; scale-mode: scale-to-fit; }
.series-label { position: absolute; right: -2%; bottom: 0; width: 57%; height: 25%; scale-mode: scale-to-fit; }
.slot-label { position: absolute; left: 3%; top: 3%; min-width: 32px; padding: 3px 5px; background-color: rgba(9, 17, 27, .88); color: rgb(133, 222, 239); font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; }
