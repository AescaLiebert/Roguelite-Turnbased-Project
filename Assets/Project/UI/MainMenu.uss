@import url("project://database/Assets/Project/Resources/UI/ScreenShell.uss?fileID=7433441132597879392&guid=6d1566d098bce684493804ab080e2ee6&type=3#ScreenShell");
.arena-background { background-image: url("../Art/UI/MainMenu/ArenaBackground.png"); }
.hero-stage { left: 18%; right: -4%; top: 0; bottom: -3%; justify-content: center; align-items: center; overflow: hidden; }
.hero-art { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100%; opacity: .96; }
.home-body { justify-content: flex-end; align-items: flex-start; padding: 34px 48px; }
.home-menu { width: 44%; max-width: 760px; min-width: 440px; }
.route-card { flex-direction: row; min-height: 176px; margin-bottom: 14px; padding: 12px; align-items: center; background-color: rgba(8, 18, 30, .78); }
.route-art { width: 36%; height: 145px; flex-shrink: 0; overflow: hidden; background-image: url("../Art/UI/DungeonEntry/ArenaBackground.png"); -unity-background-scale-mode: scale-and-crop; justify-content: flex-end; }
.route-series { font-size: 18px; padding: 5px 8px; background-color: rgba(4, 12, 24, .7); color: rgb(240, 220, 171); white-space: normal; }
.route-copy { flex-grow: 1; min-width: 0; padding-left: 18px; }
.route-eyebrow { font-size: 15px; color: rgb(161, 195, 218); letter-spacing: 1px; margin-bottom: 6px; }
.route-title { font-size: 32px; white-space: normal; margin-bottom: 8px; }
.route-fact { font-size: 20px; color: rgb(169, 208, 235); white-space: normal; margin-bottom: 5px; }
.battle-button { min-height: 88px; font-size: 40px; margin-bottom: 2px; }
.utility-button { flex-direction: row; align-items: center; justify-content: center; min-height: 84px; min-width: 0; margin-top: 12px; }
.utility-button Label, .inventory-button { font-size: 36px; }
.summon-button { border-color: rgb(233, 190, 108); color: rgb(252, 220, 162); background-color: rgba(37, 30, 24, .86); }
.training-button { border-color: rgb(113, 174, 228); color: rgb(183, 218, 251); }
.backpack-button { border-color: rgb(179, 156, 221); color: rgb(217, 201, 250); font-size: 32px; }
.inventory-button { border-color: rgb(119, 220, 203); color: rgb(176, 237, 222); padding: 12px 22px; }
.home-small-actions { flex-direction: row; }
.home-small-actions .utility-button { flex-grow: 1; flex-basis: 0; }
.home-small-actions .training-button { margin-right: 12px; }
.home-small-actions .utility-button Label { font-size: 30px; }
.inventory-screen { position: absolute; left: 0; right: 0; top: 84px; bottom: 0; }
.summon-icon, .training-icon { width: 54px; height: 54px; margin-right: 14px; }
.compact-layout .home-body { padding: 22px 32px; }
.compact-layout .hero-stage { left: 14%; right: -7%; }
.compact-layout .home-menu { width: 50%; min-width: 430px; }
.compact-layout .utility-button { min-height: 64px; margin-top: 10px; }
.compact-layout .utility-button Label, .compact-layout .inventory-button { font-size: 30px; }
.compact-layout .battle-button { min-height: 72px; font-size: 34px; }
.compact-layout .route-card { min-height: 140px; margin-bottom: 10px; }
.compact-layout .route-art { height: 118px; }
.compact-layout .route-title { font-size: 27px; }
.compact-layout .route-fact { font-size: 18px; }
.compact-layout .home-small-actions .utility-button Label, .compact-layout .backpack-button { font-size: 26px; }
.compact-layout .summon-icon, .compact-layout .training-icon { width: 42px; height: 42px; margin-right: 10px; }
.narrow-layout .home-body { padding: 24px; }
.narrow-layout .hero-stage { left: 0; right: 0; top: 82px; bottom: 28%; }
.narrow-layout .home-menu { width: 100%; min-width: 0; max-width: none; }
.narrow-layout .utility-button { min-height: 80px; }
.narrow-layout .battle-button { min-height: 88px; }
.narrow-layout .route-art { height: 150px; }
.narrow-layout .route-title { font-size: 32px; }
.loading-message { position: absolute; left: 25%; right: 25%; top: 45%; padding: 24px; background-color: rgb(14, 23, 45); font-size: 24px; -unity-text-align: middle-center; }
.training-overlay { position: absolute; left: 0; right: 0; top: 84px; bottom: 0; background-color: rgba(0, 0, 0, .9); padding: 28px; }
.training-panel { flex-grow: 1; min-height: 0; background-color: rgb(20, 30, 48); border-width: 1px; border-color: rgb(80, 157, 204); padding: 18px; }
.training-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
.training-toolbar > * { margin-right: 14px; margin-bottom: 6px; }
#training-title { flex-grow: 1; font-size: 24px; }
.training-toolbar .unity-base-field { min-width: 190px; }
.training-toolbar .unity-base-field__label { min-width: 80px; }
.training-status { margin-bottom: 12px; color: rgb(147, 209, 234); white-space: normal; }
.training-scroll { flex-grow: 1; min-height: 0; }
.training-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.training-character { width: 150px; min-height: 178px; margin: 6px; padding: 8px; align-items: center; background-color: rgb(34, 49, 76); border-width: 1px; border-color: rgb(64, 103, 130); }
.training-character:hover { background-color: rgb(43, 83, 122); }
.training-character > Label { white-space: normal; -unity-text-align: middle-center; font-size: 16px; }
