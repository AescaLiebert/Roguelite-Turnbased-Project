.route-root { flex-grow: 1; background-color: rgb(13, 17, 26); color: rgb(238, 242, 248); padding: 22px; }
.route-header { flex-direction: row; align-items: center; justify-content: space-between; min-height: 68px; border-bottom-width: 1px; border-bottom-color: rgb(53, 63, 79); }
.eyebrow { color: rgb(110, 194, 210); font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.route-title { margin-top: 4px; font-size: 21px; -unity-font-style: bold; }
.route-summary { margin-top: 4px; color: rgb(155, 170, 190); font-size: 12px; }
.route-header-actions { flex-direction: row; align-items: center; }
.run-hp-strip { flex-direction: row; min-height: 58px; align-items: center; justify-content: center; }
.run-fighter, .run-fighter-defeated { margin: 4px; padding: 9px 12px; background-color: rgb(30, 38, 52); border-bottom-width: 2px; border-bottom-color: rgb(71, 151, 132); font-size: 11px; }
.run-fighter-defeated { color: rgb(201, 132, 129); border-bottom-color: rgb(150, 78, 78); }
.route-rows { flex-grow: 1; min-height: 250px; }
.route-row { flex-direction: row; align-items: center; min-height: 68px; border-bottom-width: 1px; border-bottom-color: rgb(36, 45, 60); }
#route-row-label { width: 65px; color: rgb(130, 148, 174); font-size: 10px; -unity-font-style: bold; }
.route-nodes { flex-direction: row; flex-grow: 1; justify-content: space-evenly; }
.route-node { min-width: 150px; max-width: 245px; min-height: 49px; margin: 3px; padding: 6px; white-space: normal; background-color: rgb(34, 45, 62); color: rgb(228, 234, 242); border-bottom-width: 2px; border-bottom-color: rgb(77, 131, 158); font-size: 10px; }
.route-node-selected { background-color: rgb(49, 87, 103); border-bottom-color: rgb(216, 186, 115); }
.route-node-completed { background-color: rgb(31, 67, 60); border-bottom-color: rgb(71, 151, 132); }
.route-node-locked { opacity: 0.35; }
.node-actions { min-height: 72px; padding: 12px; background-color: rgb(23, 29, 41); flex-direction: row; flex-wrap: wrap; align-items: center; }
#choice-title { width: 100%; margin-bottom: 6px; color: rgb(223, 197, 130); font-size: 11px; -unity-font-style: bold; }
.node-actions Label { margin: 4px 10px 4px 0; font-size: 11px; color: rgb(187, 199, 215); }
.primary-button, .quiet-button { min-height: 34px; margin: 4px; padding: 6px 12px; background-color: rgb(49, 128, 146); color: white; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; font-size: 11px; }
.quiet-button { background-color: rgb(37, 46, 62); color: rgb(212, 222, 235); }
.route-error { min-height: 18px; margin-top: 6px; color: rgb(229, 144, 131); font-size: 11px; }
