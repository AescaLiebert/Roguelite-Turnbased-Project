@import url("project://database/Assets/Project/Resources/UI/ScreenShell.uss?fileID=7433441132597879392&guid=6d1566d098bce684493804ab080e2ee6&type=3#ScreenShell");
.gacha-background { background-image: url("../Art/UI/DungeonEntry/ArenaBackground.png"); }
.gacha-layout { flex-direction: row; align-items: stretch; padding: 24px 32px; }
.banner-navigation { width: 176px; min-width: 0; flex-shrink: 0; margin-right: 24px; padding: 12px; background-color: rgba(6, 16, 29, 0.8); border-width: 1px; border-color: rgba(116, 160, 194, 0.4); }
.banner-list-heading { font-size: 20px; color: rgb(167, 206, 235); margin-bottom: 12px; }
.banner-list-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
.banner-list-grid { flex-direction: column; align-items: stretch; }
.banner-card { flex-shrink: 0; min-height: 116px; padding: 0; margin-bottom: 12px; background-color: rgb(11, 25, 43); border-width: 2px; border-color: rgb(89, 132, 167); }
.banner-card-art { width: 100%; height: 78px; flex-shrink: 0; }
.banner-card-title { font-size: 17px; white-space: normal; padding: 6px 8px; color: rgb(230, 239, 247); -unity-text-align: middle-left; }
.banner-card-selected { display: none; font-size: 11px; color: rgb(255, 224, 145); padding: 0 8px 6px; -unity-text-align: middle-left; }
.banner-card.selected { border-color: rgb(247, 205, 123); background-color: rgb(45, 40, 28); }
.banner-card.selected .banner-card-selected { display: flex; }
.banner-card:hover, .banner-card:focus { border-color: rgb(240, 224, 183); }
.banner-list-empty { color: rgb(199, 214, 227); white-space: normal; font-size: 17px; }
.gacha-content { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; }
.banner-promotion { flex-grow: 1; flex-basis: 0; min-height: 0; overflow: hidden; background-color: rgba(10, 20, 35, 0.55); border-width: 1px; border-color: rgb(112, 155, 188); }
.banner-artwork { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.banner-hero { position: absolute; right: 0; width: 62%; top: 0; bottom: 0; }
.gacha-copy { width: 42%; max-width: 550px; min-width: 320px; padding: 26px; margin: 24px; background-color: rgba(6, 16, 30, 0.87); }
.banner-eyebrow { font-size: 19px; color: rgb(229, 205, 149); letter-spacing: 2px; margin-bottom: 10px; }
.banner-title { font-size: 66px; color: rgb(255, 240, 209); white-space: normal; }
.banner-description { font-size: 22px; color: rgb(191, 216, 236); white-space: normal; margin-top: 12px; }
.banner-preview-heading { font-size: 18px; color: rgb(165, 197, 220); margin-top: 28px; margin-bottom: 10px; }
#gacha-preview-grid { flex-wrap: wrap; }
#gacha-preview-grid .character-grid-card { width: 76px; min-height: 0; padding: 4px; margin: 3px; }
#gacha-preview-grid .character-grid-name { display: none; }
.gacha-guarantee-button { margin-top: 20px; min-height: 78px; padding: 10px 14px; align-items: stretch; font-size: 20px; }
.guarantee-value { font-size: 17px; color: rgb(235, 213, 166); margin-top: 3px; }
.gacha-progress-track { width: 100%; height: 6px; margin-top: 10px; background-color: rgb(42, 63, 83); overflow: hidden; }
.gacha-progress-fill { height: 100%; width: 0; background-color: rgb(236, 192, 106); }
.gacha-toolbar { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; padding-top: 16px; }
.gacha-details-button { min-height: 64px; padding: 10px 20px; }
.gacha-pull-actions { flex-direction: row; margin-left: 12px; }
.gacha-pull-button { min-height: 72px; min-width: 234px; padding: 12px 20px; flex-direction: row; align-items: center; justify-content: center; margin-left: 12px; }
.gacha-pull-button Label { font-size: 30px; }
.single-pull { background-color: rgb(235, 228, 209); border-color: rgb(255, 245, 217); color: rgb(12, 24, 39); }
.single-pull Label { color: rgb(12, 24, 39); }
.single-pull:hover { background-color: rgb(255, 243, 210); }
.pull-diamond { width: 32px; height: 32px; margin-right: 12px; background-image: url("../Art/UI/Currency/Diamond.png"); -unity-background-scale-mode: scale-to-fit; }
.gacha-notice { flex-shrink: 0; margin-top: 10px; padding: 8px 12px; background-color: rgba(8, 14, 26, 0.9); color: rgb(247, 213, 166); font-size: 17px; }
.gacha-details-panel > .unity-scroll-view__content-container > Label { font-size: 22px; white-space: normal; color: rgb(187, 214, 233); margin-bottom: 18px; }
.gacha-details-panel .character-grid { margin-bottom: 16px; }
.compact-layout .gacha-layout { padding: 18px 20px; }
.compact-layout .banner-navigation { width: 150px; margin-right: 16px; padding: 10px; }
.compact-layout .banner-card-art { height: 68px; }
.compact-layout .gacha-copy { margin: 18px; padding: 18px; min-width: 320px; }
.compact-layout .banner-title { font-size: 48px; }
.compact-layout .banner-preview-heading { margin-top: 20px; }
.compact-layout .gacha-pull-button { min-width: 210px; min-height: 64px; padding: 10px 16px; }
.compact-layout .gacha-pull-button Label { font-size: 26px; }
.narrow-layout .gacha-layout { padding: 14px 12px; }
.narrow-layout .banner-navigation { width: 112px; margin-right: 12px; padding: 6px; }
.narrow-layout .banner-list-heading { font-size: 17px; }
.narrow-layout .banner-card { min-height: 100px; }
.narrow-layout .banner-card-art { height: 60px; }
.narrow-layout .banner-card-title { font-size: 16px; padding: 5px; }
.narrow-layout .gacha-copy { position: absolute; left: 12px; right: 12px; bottom: 12px; width: auto; min-width: 0; max-width: none; margin: 0; padding: 18px; }
.narrow-layout .banner-title { font-size: 44px; }
.narrow-layout .banner-preview-heading { margin-top: 14px; }
.narrow-layout .gacha-guarantee-button { margin-top: 12px; }
.narrow-layout .gacha-toolbar { flex-wrap: wrap; padding-top: 10px; }
.narrow-layout .gacha-details-button { min-height: 48px; font-size: 21px; }
.narrow-layout .gacha-pull-actions { width: 100%; margin: 10px 0 0; }
.narrow-layout .gacha-pull-button { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 8px; padding: 10px 8px; }
.narrow-layout .single-pull { margin-left: 0; }
.narrow-layout .gacha-pull-button Label { font-size: 24px; white-space: normal; }
.narrow-layout .pull-diamond { width: 26px; height: 26px; margin-right: 8px; }
.loading-message { position: absolute; left: 25%; right: 25%; top: 45%; padding: 24px; background-color: rgb(14, 23, 45); font-size: 24px; -unity-text-align: middle-center; }
