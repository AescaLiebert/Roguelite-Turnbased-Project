.battle-card-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.battle-card-tray {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 2%;
    height: 35%;
    min-height: 230px;
    max-height: 380px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 8px;
    background-color: rgba(8, 13, 21, 0.88);
    border-top-width: 2px;
    border-top-color: rgba(220, 185, 105, 0.8);
    flex-direction: column;
    justify-content: flex-end;
}

.card-tooltip {
    min-height: 38px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    color: rgb(245, 239, 224);
    background-color: rgba(12, 16, 22, 0.94);
    border-left-width: 3px;
    border-left-color: rgb(218, 180, 91);
    font-size: 13px;
    white-space: normal;
    display: none;
}

.action-row {
    height: 112px;
    margin-bottom: 8px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.deck-row {
    height: 126px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.card-slot {
    width: 92px;
    height: 116px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(21, 28, 38, 0.9);
    border-width: 1px;
    border-color: rgba(137, 151, 169, 0.55);
    justify-content: center;
    align-items: center;
}

.action-slot {
    width: 98px;
    height: 108px;
    margin-left: 7px;
    margin-right: 7px;
    background-color: rgba(27, 35, 47, 0.92);
    border-width: 2px;
    border-color: rgba(169, 184, 201, 0.75);
}

.slot-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.slot-marker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgba(196, 208, 222, 0.68);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.tray-controls {
    height: 34px;
    margin-top: 4px;
    flex-direction: row;
    justify-content: flex-end;
}

.reset-button {
    min-width: 104px;
    height: 32px;
    padding-left: 15px;
    padding-right: 15px;
    color: rgb(232, 236, 242);
    background-color: rgba(43, 55, 72, 0.96);
    border-width: 1px;
    border-color: rgba(148, 162, 181, 0.52);
}

.reset-button:disabled {
    opacity: 0.38;
}
