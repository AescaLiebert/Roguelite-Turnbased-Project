<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="AccountHeader" src="project://database/Assets/Project/Resources/UI/AccountHeader.uxml?fileID=9197481963319205126&amp;guid=48842567732fe4840bdbaeeeaa1ebcf8&amp;type=3#AccountHeader"/>
    <Style src="project://database/Assets/Project/UI/DungeonRouteMap.uss?fileID=7433441132597879392&amp;guid=576f26011ad04564c8dbeac1e763a735&amp;type=3#DungeonRouteMap"/>
    <ui:VisualElement name="route-root" class="screen-root route-root">
        <ui:Instance template="AccountHeader" class="account-header-instance">
            <AttributeOverrides element-name="section-title" text="BATTLE / DUNGEON MAP"/>
        </ui:Instance>
        <ui:VisualElement style="flex-grow: 1; position: absolute;"/>
        <ui:VisualElement class="screen-body">
            <ui:VisualElement class="route-header">
                <ui:VisualElement class="route-heading">
                    <ui:Label name="route-title" text="No active run" class="route-title heavy" style="display: flex;"/>
                </ui:VisualElement>
                <ui:VisualElement class="route-header-actions">
                    <ui:Button name="abandon-button" text="Abandon run" class="action-button"/>
                    <ui:Button name="return-loadout-button" text="Return to Dungeon Select" class="action-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="adaptive-columns labyrinth-content">
                <ui:ScrollView name="route-rows" mode="VerticalAndHorizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="route-rows"/>
                <ui:VisualElement class="stage-detail surface-panel">
                    <ui:Label text="STAGE DETAIL" class="section-heading"/>
                    <ui:ScrollView name="stage-detail-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="stage-inspection-scroll">
                        <ui:VisualElement name="node-actions" class="node-actions"/>
                    </ui:ScrollView>
                    <ui:VisualElement name="node-commit-actions"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="route-error" class="body-copy route-error"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
