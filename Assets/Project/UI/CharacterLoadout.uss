@import url("project://database/Assets/Project/Resources/UI/ScreenShell.uss?fileID=7433441132597879392&guid=6d1566d098bce684493804ab080e2ee6&type=3#ScreenShell");
.loadout-root { background-color: rgb(10, 19, 31); }
.loadout-title { font-size: 58px; margin-bottom: 8px; flex-shrink: 0; }
#loadout-policy { margin-bottom: 16px; flex-shrink: 0; }
.loadout-content { flex-direction: column; flex-grow: 1; flex-basis: 0; min-height: 0; }
.formation-panel { flex-shrink: 0; min-width: 0; margin-bottom: 20px; padding: 16px; }
.formation-toolbar { flex-direction: row; align-items: center; margin-bottom: 10px; flex-shrink: 0; }
.formation-toolbar .section-heading { margin-bottom: 0; }
.formation-stats { flex-grow: 1; margin-left: 24px; color: rgb(252, 222, 165); }
#clear-position { min-height: 40px; font-size: 22px; padding: 6px 16px; }
.formation-help { margin-bottom: 10px; font-size: 17px; }
.formation-slots { flex-direction: row; flex-wrap: nowrap; min-width: 0; }
.formation-slot { flex-grow: 1; flex-basis: 0; min-width: 0; flex-shrink: 1; align-items: center; padding: 10px; margin-right: 12px; border-width: 2px; border-color: rgb(71, 114, 145); background-color: rgb(13, 30, 45); }
.formation-slot.reserve-position { margin-right: 0; margin-left: 12px; border-top-color: rgb(161, 130, 79); }
.formation-slot.selected { border-color: rgb(255, 220, 143); background-color: rgb(29, 46, 58); }
.formation-slot Label { white-space: normal; -unity-text-align: middle-center; font-size: 20px; }
.formation-role { color: rgb(119, 220, 203); margin-bottom: 8px; }
.reserve-position .formation-role { color: rgb(246, 208, 139); }
.formation-body { align-items: center; width: 100%; min-width: 0; }
.formation-icon { width: 112px; height: 112px; flex-shrink: 0; }
.formation-details { align-items: center; min-width: 0; }
.formation-name { margin-top: 6px; }
.formation-slot .formation-character-stats { margin-top: 6px; font-size: 15px; color: rgb(154, 196, 224); }
.formation-slot .slot-label { min-width: 24px; padding: 2px 3px; font-size: 10px; margin: 0; }
.empty-position { width: 100%; height: 100%; align-items: center; justify-content: center; border-width: 1px; border-color: rgb(57, 87, 111); }
.empty-position Label { font-size: 48px; color: rgb(111, 148, 174); }
.collection-panel { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: 16px; }
.collection-toolbar { flex-direction: row; align-items: center; justify-content: space-between; }
.collection-toolbar .section-heading { margin-bottom: 0; margin-right: 20px; flex-shrink: 0; }
.collection-count { flex-grow: 1; min-width: 0; margin-right: 20px; font-size: 18px; }
#fighter-search { min-width: 220px; font-size: 20px; }
#fighter-search .unity-base-field__label { min-width: 60px; color: rgb(159, 200, 228); }
.collection-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; margin-top: 12px; }
.loadout-footer { flex-direction: row; flex-shrink: 0; align-items: center; justify-content: space-between; padding-top: 16px; }
#loadout-status { flex-grow: 1; min-width: 0; margin-right: 20px; }
#loadout-play { min-width: 330px; }
.compact-layout .loadout-title { font-size: 36px; margin-bottom: 4px; }
.compact-layout #loadout-policy { font-size: 16px; margin-bottom: 10px; }
.compact-layout .formation-panel { padding: 10px; margin-bottom: 12px; }
.compact-layout .formation-toolbar { margin-bottom: 8px; }
.compact-layout .formation-toolbar .section-heading { font-size: 24px; }
.compact-layout .formation-stats { font-size: 17px; margin-left: 16px; }
.compact-layout .formation-help { display: none; }
.compact-layout #clear-position { min-height: 32px; padding: 4px 12px; font-size: 18px; }
.compact-layout .formation-slot { padding: 6px; margin-right: 8px; }
.compact-layout .formation-slot.reserve-position { margin-right: 0; margin-left: 8px; }
.compact-layout .formation-role { font-size: 18px; margin-bottom: 4px; }
.compact-layout .formation-body { flex-direction: row; justify-content: center; }
.compact-layout .formation-icon { width: 88px; height: 88px; }
.compact-layout .formation-details { flex-grow: 1; flex-basis: 0; margin-left: 8px; }
.compact-layout .formation-name { margin-top: 0; font-size: 17px; }
.compact-layout .formation-character-stats { margin-top: 4px; font-size: 13px; }
.compact-layout .collection-panel { padding: 8px; }
.compact-layout .collection-toolbar .section-heading { font-size: 24px; }
.compact-layout .collection-count { font-size: 16px; }
.compact-layout #fighter-search { font-size: 16px; }
.compact-layout #fighter-search .unity-base-field__input { min-height: 28px; height: 28px; padding: 0 6px; }
.compact-layout .collection-scroll { margin-top: 8px; }
.compact-layout .loadout-footer { padding-top: 8px; }
.compact-layout #loadout-play { min-height: 60px; font-size: 30px; }
.narrow-layout .formation-body { flex-direction: column; }
.narrow-layout .formation-icon { width: 80px; height: 80px; }
.narrow-layout .formation-details { flex-grow: 0; flex-basis: auto; margin-left: 0; width: 100%; }
.narrow-layout .formation-name { font-size: 16px; margin-top: 4px; }
.narrow-layout .formation-character-stats { font-size: 12px; }
.narrow-layout .formation-stats { font-size: 15px; margin-left: 10px; }
.narrow-layout .collection-toolbar .section-heading { font-size: 24px; }
.narrow-layout .loadout-footer { flex-direction: column; align-items: stretch; }
.narrow-layout #loadout-status { font-size: 17px; margin-right: 0; }
.narrow-layout #loadout-play { min-width: 0; min-height: 56px; font-size: 28px; margin-top: 8px; }
