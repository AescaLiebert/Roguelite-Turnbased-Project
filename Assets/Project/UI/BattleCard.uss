.card-face {
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: rgb(24, 29, 38);
    border-width: 2px;
    border-color: rgb(184, 139, 55);
    overflow: hidden;
}

.card-face:hover {
    border-color: rgb(255, 220, 119);
}

.card-artwork {
    position: absolute;
    left: 3px;
    right: 3px;
    top: 3px;
    bottom: 3px;
}

.card-rank {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    height: 20px;
    padding-left: 3px;
    padding-right: 3px;
    color: rgb(255, 218, 109);
    background-color: rgba(6, 9, 14, 0.82);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
