.card-face {
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: rgb(22, 26, 35);
    border-width: 2px;
    border-color: rgb(184, 139, 55);
    overflow: hidden;
    border-radius: 6px;
    transition-property: scale, translate, border-color;
    transition-duration: 160ms;
    transition-timing-function: ease-out;
}

.card-face:hover {
    border-color: rgb(255, 230, 130);
    scale: 1 1;
    translate: 0 0;
}

.card-artwork {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    bottom: 2px;
    border-radius: 4px;
}

.card-rank-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.card-skill-slot {
    position: absolute;
    left: 5px;
    top: 5px;
    min-width: 22px;
    height: 22px;
    padding-left: 5px;
    padding-right: 5px;
    border-radius: 11px;
    background-color: rgba(12, 17, 26, 0.92);
    border-width: 1px;
    border-color: rgba(255, 215, 120, 0.6);
    color: rgb(255, 245, 220);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
    white-space: nowrap;
}

.card-skill-type {
    position: absolute;
    right: 5px;
    top: 5px;
    width: 26px;
    height: 26px;
    scale-mode: scale-to-fit;
    -unity-background-scale-mode: scale-to-fit;
}

.card-disabled-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0.58);
}

.hand-card.card-disabled-by-status .card-disabled-overlay {
    display: flex;
}

/* 7DSGC-style Holographic / Golden Aura on Ultimate Cards */
.ultimate-card .card-face {
    border-width: 2.5px;
    border-color: rgb(255, 220, 90);
    background-color: rgb(38, 26, 12);
}

.ultimate-card .card-skill-slot {
    background-color: rgba(220, 130, 15, 0.95);
    border-color: rgb(255, 235, 160);
    color: rgb(255, 255, 255);
}

.card-holo-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-color: rgba(255, 215, 60, 0.18);
    border-width: 2px;
    border-color: rgba(255, 240, 170, 0.7);
    border-radius: 4px;
}

.ultimate-card .card-holo-glow {
    display: flex;
}
