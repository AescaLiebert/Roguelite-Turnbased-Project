  studioMetadataJson: "{\"CategoryId\":9130,\"SchemaVersion\":1,\"RuntimeReady\":true,\"Id\":\"fighter.pre-release.xiangling\",\"SourceId\":\"pre-release-character.csv#row-31\",\"SourceRecord\":31,\"DisplayName\":\"Xiangling\",\"FamilyId\":\"family.xiangling\",\"Role\":\"\",\"SeriesId\":\"series.genshin-impact\",\"AttributeId\":\"attribute.red\",\"RarityId\":\"rarity.ssr\",\"TraitIds\":[\"trait.women\",\"trait.genshin-impact\",\"trait.region.liyue\"],\"BaseStats\":{\"Attack\":460,\"Defense\":290,\"MaxHealth\":6400,\"CombatClass\":3840,\"HasDerivedCombatClass\":false,\"CombatClassReferenceValue\":0,\"CombatClassFlatBonus\":0,\"CombatClassReferenceScore\":0,\"CombatClassGrowthScore\":0,\"PierceBp\":6000,\"ResistanceBp\":2000,\"RegenerationBp\":0,\"CritChanceBp\":1000,\"CritDamageBp\":13000,\"CritResistanceBp\":3000,\"CritDefenseBp\":0,\"RecoveryBp\":12000,\"BlockChanceBp\":0,\"BlockPowerBp\":0,\"LifeStealBp\":1500,\"EvadeBp\":0,\"PerceptionBp\":10000,\"ControlBp\":10000,\"AvoidanceBp\":10000,\"ReflectDamageBp\":0,\"DamageOverTimeDealtBp\":0,\"DamageDealtBp\":0,\"AdditionalDamageDealtBp\":0,\"ElementalModifiers\":[]},\"StatGrowth\":{\"AttackBp\":100,\"DefenseBp\":100,\"HealthBp\":100,\"CombatClassBp\":0},\"ArtifactLoadout\":[],\"Skills\":[],\"PassiveId\":\"fighter.pre-release.xiangling.passive\",\"PassiveSource\":{\"SourceType\":\"\",\"Description\":\"\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e14\u0e32\u0e40\u0e21\u0e08 Pyro \u0e02\u0e36\u0e49\u0e19 +20%\\n\u0e40\u0e21\u0e37\u0e48\u0e2d Guoba \u0e42\u0e08\u0e21\u0e15\u0e35\u0e42\u0e14\u0e19\u0e28\u0e31\u0e15\u0e23\u0e39\u0e08\u0e30\u0e25\u0e14 Pyro RES \u0e25\u0e14 -20% 2 \u0e40\u0e17\u0e34\u0e23\u0e4c\u0e19\\n\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e14\u0e32\u0e40\u0e21\u0e08\u0e02\u0e2d\u0e07 Guoba \u0e02\u0e36\u0e49\u0e19\u0e17\u0e38\u0e01\u0e46 0.8% \u0e02\u0e2d\u0e07\u0e04\u0e48\u0e32 DOT Dealt\\n\u0e43\u0e19\u0e02\u0e19\u0e32\u0e14\u0e17\u0e35\u0e48 Guoba \u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e2a\u0e19\u0e32\u0e21\u0e15\u0e19\u