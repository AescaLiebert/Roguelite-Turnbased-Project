c target; the source does not explicitly specify its target scope.\"],\"SourceTraits\":[\"Female\",\"Genshin Impact\",\"Genshin-Hexerei\",\"Genshin-Monstadt\"],\"SourceStats\":[{\"StatId\":\"Attack\",\"SourceField\":\"ATK\",\"SourceValue\":480.0,\"Unit\":\"stat\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":480.0},{\"StatId\":\"Defense\",\"SourceField\":\"DEF\",\"SourceValue\":280.0,\"Unit\":\"stat\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":280.0},{\"StatId\":\"MaxHealth\",\"SourceField\":\"HP\",\"SourceValue\":6300.0,\"Unit\":\"stat\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":6300.0},{\"StatId\":\"CombatClass\",\"SourceField\":\"Class Power\",\"SourceValue\":3890.0,\"Unit\":\"stat\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":3890.0},{\"StatId\":\"Pierce\",\"SourceField\":\"Pierce Rate\",\"SourceValue\":30.0,\"Unit\":\"percent\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":3000.0},{\"StatId\":\"Resistance\",\"SourceField\":\"Resistence\",\"SourceValue\":10.0,\"Unit\":\"percent\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":1000.0},{\"StatId\":\"Regeneration\",\"SourceField\":\"Regenerate\",\"SourceValue\":10.0,\"Unit\":\"percent\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":1000.0},{\"StatId\":\"CritChance\",\"SourceField\":\"Crit Chance\",\"SourceValue\":50.0,\"Unit\":\"percent\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":5000.0},{\"StatId\":\"CritDamage\",\"SourceField\":\"Crit Damage\",\"SourceValue\":170.0,\"Unit\":\"percent\",\"Provenance\":\"ArtDirection/Character Database/Pre-Release-Character.csv\",\"Value\":17000.0},{\"StatId\":\"CritResistance\",\"SourceField\":\"Crit Resistence\",\"SourceValue\":0.0,\"Unit\":\"per